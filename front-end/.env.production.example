# ==============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE — FRONTEND
# ==============================================================================
# HƯỚNG DẪN BẢO MẬT:
# 1. Sao chép thành '.env.production' hoặc '.env.production.local' khi build production.
# 2. KHÔNG đặt secret key/private token vào các biến có tiền tố NEXT_PUBLIC_ vì
#    chúng sẽ bị nhúng công khai vào mã JavaScript chạy trên trình duyệt người dùng.
# ==============================================================================

# URL API Backend ở môi trường Production (HTTPS bắt buộc)
NEXT_PUBLIC_API_BASE_URL="https://api.quiz.yourdomain.com"
