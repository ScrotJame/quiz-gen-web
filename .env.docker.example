# ==============================================================================
# DOCKER COMPOSE DEPLOYMENT CONFIGURATION
# ==============================================================================
# Cách sử dụng:
# 1. Sao chép thành '.env' trước khi chạy: docker compose up -d --build
# 2. Điền GEMINI_API_KEY và CLOUDFLARE_TUNNEL_TOKEN
# ==============================================================================

# --- AI Engines ---
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-3.1-flash-lite"
GEMINI_OCR_MODEL="gemini-3.1-flash-lite"

# --- Database ---
POSTGRES_USER="quiz_user"
POSTGRES_PASSWORD="CHANGE_ME_SECURE_PASSWORD"
POSTGRES_DB="quiz_prod_db"

# --- Domains & Networking ---
# URL frontend gọi tới backend khi người dùng truy cập web
NEXT_PUBLIC_API_BASE_URL="https://api.quiz.yourdomain.com"
# Danh sách domain được phép gọi API (CORS)
CORS_ORIGINS="https://quiz.yourdomain.com,http://localhost:3000"

# --- Cloudflare Tunnel ---
# Lấy Tunnel Token tại: Cloudflare Zero Trust -> Networks -> Tunnels
# (Nếu chỉ test local không cần Cloudflare, có thể để trống và truy cập qua localhost:3000)
CLOUDFLARE_TUNNEL_TOKEN=""
