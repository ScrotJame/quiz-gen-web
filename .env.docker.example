# ==============================================================================
# DOCKER DEPLOYMENT CONFIGURATION (PROD & DEV SHARED DATABASE)
# ==============================================================================
# 1. Triển khai Production (Docker Compose):
#      cp .env.docker.example .env
#      docker compose up -d --build
#
# 2. Phát triển Dev Local (Dùng chung DB PostgreSQL từ container):
#      docker compose up -d postgres
#      (Khi đó backend local trỏ vào DATABASE_URL=postgresql+asyncpg://...:@localhost:5432/...)
# ==============================================================================

# --- AI Engines ---
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_OCR_MODEL="gemini-2.5-flash"
GEMINI_TEMPERATURE=0.3
MISTRAL_API_KEY=""

# --- PostgreSQL Database (Dùng chung giữa Dev và Prod) ---
POSTGRES_USER="quiz_user"
POSTGRES_PASSWORD="quiz_secret_password"
POSTGRES_DB="quiz_prod_db"

# Chuỗi kết nối:
# - Cho Production Container:
#   postgresql+asyncpg://quiz_user:quiz_secret_password@postgres:5432/quiz_prod_db
# - Cho Development Local (ngoài host):
#   postgresql+asyncpg://quiz_user:quiz_secret_password@localhost:5432/quiz_prod_db

# --- Domains & Networking ---
# URL frontend gọi tới backend từ trình duyệt
NEXT_PUBLIC_API_URL="http://localhost:8000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# --- Cloudflare Tunnel (Tùy chọn cho Production Internet Access) ---
# Lấy Tunnel Token tại: Cloudflare Zero Trust -> Networks -> Tunnels
# Chạy với cờ: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=""
