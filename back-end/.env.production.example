
# --- 1. APPLICATION SETTINGS ---
APP_NAME=""
APP_ENV="production"
APP_PORT=8000
APP_HOST="0.0.0.0"
LOG_LEVEL="WARNING"

CORS_ORIGINS=""

# --- 2. PRODUCTION DATABASE (PostgreSQL Khuyến Nghị) ---
DATABASE_URL=""
DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
USE_IN_MEMORY_REPOS=false

# --- 3. GOOGLE GEMINI AI (Quiz Generation & Multimodal OCR) ---
GEMINI_API_KEY=""
GEMINI_MODEL=""
GEMINI_OCR_MODEL=""
GEMINI_TEMPERATURE=0.3

# --- 4. MISTRAL AI (Tùy chọn / Dự phòng) ---
MISTRAL_API_KEY=""
MISTRAL_MODEL="ministral-14b-2512"
MISTRAL_TEMPERATURE=0.3

# --- 5. SECURITY & UPLOAD LIMITS ---
# Giới hạn kích thước file ảnh tải lên (Megabytes) để chống tấn công DoS/OOM
MAX_UPLOAD_SIZE_MB=10
