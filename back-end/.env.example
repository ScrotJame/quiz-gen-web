# Application
APP_NAME="Quiz Web Backend"
APP_ENV="development"
APP_PORT=8000
APP_HOST="0.0.0.0"
LOG_LEVEL="INFO"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database (mặc định dùng SQLite async, có thể đổi sang postgresql+asyncpg://user:pass@localhost:5432/quizdb)
DATABASE_URL="sqlite+aiosqlite:///./quiz.db"
DB_ECHO=false
USE_IN_MEMORY_REPOS=false

# Mistral AI (Quiz Generation)
MISTRAL_API_KEY=""
MISTRAL_MODEL=""
MISTRAL_TEMPERATURE=0.3

# Gemini AI (Quiz Generation & OCR Engine)
GEMINI_API_KEY=""
GEMINI_MODEL=""
GEMINI_OCR_MODELS="gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash"
GEMINI_OCR_MODEL=""
GEMINI_TEMPERATURE=0.3

# Local OCR & RapidOCR Detector Hyperparameters
LOCAL_OCR_ENABLED=true
LOCAL_OCR_BATCH_SIZE=16
LOCAL_OCR_TIMEOUT_SECONDS=30
VIETOCR_DEVICE="cpu"
VIETOCR_BEAMSEARCH=false
RAPIDOCR_UNCLIP_RATIO=1.45
RAPIDOCR_BOX_THRESH=0.42
RAPIDOCR_THRESH=0.20
RAPIDOCR_LIMIT_SIDE_LEN=960
RAPIDOCR_LIMIT_TYPE="max"
RAPIDOCR_USE_DILATION=false
RAPIDOCR_SPLIT_TALL_BOXES=false
RAPIDOCR_ENABLE_CLAHE=true
